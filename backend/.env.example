# Application
APP_NAME="Unishop API"
ENVIRONMENT=local
DEBUG=true

# PostgreSQL — user/password/db come from the root .env (shared with the
# postgres container itself). This is only the host: "localhost" when running
# outside Docker, overridden to "postgres" by docker-compose for the backend
# container.
POSTGRES_HOST=localhost

# Redis — same idea as Postgres above.
REDIS_HOST=localhost

# Keycloak client secret must match keycloak/realm-import.json.
KEYCLOAK_CLIENT_SECRET=unishop-backend-secret

# Random string used to sign the short-lived OAuth handshake cookie.
# Generate your own for anything beyond local dev: openssl rand -hex 32
OAUTH_STATE_SECRET=dev-only-oauth-state-secret
