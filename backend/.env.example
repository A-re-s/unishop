# Application
APP_NAME="Unishop API"
ENVIRONMENT=local
DEBUG=true

# PostgreSQL — user/password/db come from the root .env (shared with the
# postgres container itself). This is only the host: "localhost" when running
# outside Docker, overridden to "postgres" by docker-compose for the backend
# container.
POSTGRES_HOST=localhost

# Redis — same idea as Postgres above.
REDIS_HOST=localhost

# MinIO — same idea as Postgres above.
MINIO_HOST=localhost

# Keycloak client secret must match keycloak/realm-import.json.
KEYCLOAK_CLIENT_SECRET=unishop-backend-secret

# Random string used to sign the short-lived OAuth handshake cookie.
# Generate your own for anything beyond local dev: openssl rand -hex 32
OAUTH_STATE_SECRET=dev-only-oauth-state-secret

# --- Real deployment (domain or bare IP) ---
# The defaults above only work for `just up` on localhost. Deploying with
# `just up-prod` on an actual host requires all four of these — nginx serves
# the frontend and /api/ on the same origin, but Keycloak stays on its own
# published port (see docker-compose.prod.yml), so the browser needs to be
# told both addresses explicitly. Replace <host> with your domain or IP.
#
# FRONTEND_BASE_URL=http://<host>
# KEYCLOAK_PUBLIC_ISSUER=http://<host>:8080/realms/unishop
# PHOTOS_PUBLIC_BASE_URL=http://<host>/media
#
# Cookies with Secure require HTTPS — leave this false until TLS is in front
# of nginx, otherwise the browser silently drops the
# session cookie and login appears to do nothing.
# SESSION_COOKIE_SECURE=false
