# Shared infrastructure services used by docker-compose.
# These services aren't wired into docker-compose.yml yet and will be added
# during development (Postgres, Redis, MinIO, Authentik) — this file just
# reserves the convention for where their credentials will live.

# --- PostgreSQL ---
POSTGRES_USER=unishop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=unishop
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- MinIO ---
MINIO_ROOT_USER=unishop
MINIO_ROOT_PASSWORD=change-me
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Authentik ---
AUTHENTIK_SECRET_KEY=change-me
AUTHENTIK_POSTGRES_PASSWORD=change-me
AUTHENTIK_PORT=9443
