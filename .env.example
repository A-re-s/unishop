# Shared infrastructure services used by docker-compose.
# MinIO isn't wired into docker-compose.yml yet and will be added during
# development — that section just reserves the convention for where its
# credentials will live.

# --- PostgreSQL (app database) ---
POSTGRES_USER=unishop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=unishop
POSTGRES_PORT=5432

# --- Redis (sessions) ---
REDIS_PORT=6379

# --- MinIO ---
MINIO_ROOT_USER=unishop
MINIO_ROOT_PASSWORD=change-me
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Keycloak (OIDC identity provider) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_PORT=8080
